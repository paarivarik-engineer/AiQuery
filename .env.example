# Flask Configuration
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# Database Configuration (local Docker)
DATABASE_URL=postgresql://aiquery:aiquery@db:5432/aiquery

# AWS RDS PostgreSQL (for external/production database)
# Use either DATABASE_URL or the individual vars below.
# DATABASE_URL=postgresql://USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/DATABASE?sslmode=require
# AWS_DB_HOST=your-instance.region.rds.amazonaws.com
# AWS_DB_PORT=5432
# AWS_DB_NAME=your_database
# AWS_DB_USER=your_user
# AWS_DB_PASSWORD=your_password
# AWS_DB_SSLMODE=require

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Email Configuration (for password reset)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password #Make sure to use a app password for ur google account rather than using your main google account's password.
MAIL_DEFAULT_SENDER=noreply@example.com
